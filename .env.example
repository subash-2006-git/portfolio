NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Local test inbox (filled by npm run db:env). New-message emails land here in development.
MAILPIT_URL=http://127.0.0.1:56324

# Production email for new contact messages (https://resend.com). Takes priority over Mailpit.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Portfolio <hello@yourdomain.com>"
NOTIFY_FROM=
# Where notifications go. Defaults to the email on your profile.
NOTIFY_EMAIL=
